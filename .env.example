# Optional. The app already includes the public web config for
# virtual-internship-b25d1. Set these only to point at a different project.
# Do not commit .env.local.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Stripe Price IDs created for the "Run Payments with Stripe" Firebase extension.
# Monthly maps to Premium. Yearly maps to Premium Plus and starts a 7-day trial.
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_YEARLY_PRICE_ID=
